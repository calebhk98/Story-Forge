# =============================================================================
# Story Forge configuration
# =============================================================================
# Copy this file to `.env` and fill in values. The .env file is loaded at
# startup to seed the settings table on first run. After that, settings live
# in the database and can be edited via the settings UI/API.
#
# Settings flagged "RESTART REQUIRED" cannot be changed at runtime.
# =============================================================================


# -----------------------------------------------------------------------------
# Tenancy
# -----------------------------------------------------------------------------
# Identifier for the owner of records created by this process. Single-user
# local installs can leave this as "local". A service deployment should
# inject a per-request value via the API layer instead.
OWNER_ID=local


# -----------------------------------------------------------------------------
# Database (RESTART REQUIRED)
# -----------------------------------------------------------------------------
# Choose: sqlite | postgres
DB_TYPE=sqlite

# For sqlite, a file path. The directory must exist.
SQLITE_PATH=./data/story-forge.db

# For postgres, a standard URL.
# Format: postgres://user:password@host:port/database
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/story_forge


# -----------------------------------------------------------------------------
# Vector store (RESTART REQUIRED)
# -----------------------------------------------------------------------------
# Choose: sqlite-vec | pgvector | qdrant | chroma
# Defaults to whatever matches DB_TYPE (sqlite-vec or pgvector).
VECTOR_STORE=sqlite-vec

# Qdrant settings (only used when VECTOR_STORE=qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Chroma settings (only used when VECTOR_STORE=chroma)
CHROMA_URL=http://localhost:8000


# -----------------------------------------------------------------------------
# LLM providers
# -----------------------------------------------------------------------------
# Default model used for any tier that does not have its own override.
# Provider options: anthropic | gemini | openai-compatible
LLM_DEFAULT_PROVIDER=openai-compatible
LLM_DEFAULT_BASE_URL=http://localhost:11434/v1
LLM_DEFAULT_API_KEY=
LLM_DEFAULT_MODEL=llama3.1:8b

# Per-tier overrides. Any tier left blank inherits from default.
# Tiers: critic, character, narrator, perception, summarizer.

LLM_CRITIC_PROVIDER=
LLM_CRITIC_BASE_URL=
LLM_CRITIC_API_KEY=
LLM_CRITIC_MODEL=

LLM_CHARACTER_PROVIDER=
LLM_CHARACTER_BASE_URL=
LLM_CHARACTER_API_KEY=
LLM_CHARACTER_MODEL=

LLM_NARRATOR_PROVIDER=
LLM_NARRATOR_BASE_URL=
LLM_NARRATOR_API_KEY=
LLM_NARRATOR_MODEL=

LLM_PERCEPTION_PROVIDER=
LLM_PERCEPTION_BASE_URL=
LLM_PERCEPTION_API_KEY=
LLM_PERCEPTION_MODEL=

LLM_SUMMARIZER_PROVIDER=
LLM_SUMMARIZER_BASE_URL=
LLM_SUMMARIZER_API_KEY=
LLM_SUMMARIZER_MODEL=

# Provider-specific keys (only used if a tier picks them as provider)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=


# -----------------------------------------------------------------------------
# Generation defaults (overridable per story)
# -----------------------------------------------------------------------------
# Plot mode: strict | guided | emergent
DEFAULT_PLOT_MODE=guided

# Perception mode: binary | llm-judged
DEFAULT_PERCEPTION_MODE=binary

# Narrator voice: first | second | third-limited | third-omniscient
DEFAULT_NARRATOR_VOICE=third-limited

# POV: single | multi
DEFAULT_POV=single


# -----------------------------------------------------------------------------
# Run budgets (overridable per run)
# -----------------------------------------------------------------------------
# Hard caps for a single generation run. Any cap tripped pauses the run.
# Set to 0 to disable a cap.
MAX_TOKENS_PER_RUN=2000000
MAX_CALLS_PER_RUN=5000
MAX_WALLCLOCK_SECONDS_PER_RUN=28800   # 8 hours
MAX_COST_USD_PER_RUN=0                # 0 means unlimited; requires price config to enforce


# -----------------------------------------------------------------------------
# Critic loop
# -----------------------------------------------------------------------------
CRITIC_MAX_ITERATIONS_PER_SCENE=3


# -----------------------------------------------------------------------------
# Retry policy
# -----------------------------------------------------------------------------
LLM_MAX_RETRIES=3
LLM_INITIAL_BACKOFF_MS=1000
LLM_MAX_BACKOFF_MS=30000
LLM_REQUEST_TIMEOUT_MS=120000


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Levels: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
LOG_PRETTY=false


# -----------------------------------------------------------------------------
# API server (only used in service mode)
# -----------------------------------------------------------------------------
API_ENABLED=false
API_PORT=3000
API_HOST=127.0.0.1
