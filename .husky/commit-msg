#!/bin/sh
COMMIT_MSG=$(cat "$1")
PREFIX=$(echo "$COMMIT_MSG" | head -1 | sed 's/:.*//')

# test: commits are intentionally red — allow them through
if [ "$PREFIX" = "test" ]; then
  exit 0
fi

# All other prefixes (feat:, fix:, refactor:, etc.) must have passing tests
STAGED_TS=$(git diff --cached --name-only --diff-filter=d | grep '\.ts$' || true)

if [ -z "$STAGED_TS" ]; then
  exit 0
fi

# shellcheck disable=SC2086
npx vitest related $STAGED_TS --run --reporter=dot
