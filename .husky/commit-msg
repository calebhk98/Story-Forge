#!/bin/sh
COMMIT_MSG=$(cat "$1")
PREFIX=$(echo "$COMMIT_MSG" | head -1 | sed 's/:.*//')

STAGED_TS=$(git diff --cached --name-only --diff-filter=d | grep '\.ts$' || true)

if [ -z "$STAGED_TS" ]; then
  exit 0
fi

# shellcheck disable=SC2086
if [ "$PREFIX" = "test" ]; then
  # test: commits are intentionally red — show results but never block
  npx vitest related $STAGED_TS --run --reporter=dot || true
else
  # All other prefixes must have passing tests
  npx vitest related $STAGED_TS --run --reporter=dot
fi
